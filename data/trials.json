 "meta": {
  "design": "within-subjects crossover; A = click-to-reveal on-map popup, B = hover-to-reveal persistent side panel",
  "blocks": "each participant completes 1 practice + 5 measured trials per interface (10 measured total)",
  "candidate_pool": "medium-severity zones (measured), low-severity (practice); all candidates in a trial share one colour",
  "candidates_per_trial": 6,
  "start_zoom": 13,
  "displayed_fields": [
   "severity",
   "depth_band",
   "buildings_catchment",
   "building_area_m2"
  ],
  "shortcut_guards": [
   "target has >= 3 candidates larger (or smaller) by zone area",
   "|corr(zone area, target attribute)| <= 0.6 within each candidate set",
   "no ties on the target attribute",
   "all candidates rendered in one uniform colour (severity cannot be read from fill)"
  ],
  "matching": "slot-matched across sets: same attribute, direction, difficulty tier and near-identical top1-top2 gap",
  "rendering_note": "zones are thin bands (~160 m wide); add a transparent wide stroke (e.g. 12-15 px) to enlarge the hover/click hit area",
  "input": "desktop pointer only; touch not supported",
  "answer_key_note": "answer key ships client-side on a static site and is inspectable in principle"
 },
